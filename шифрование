# Импортируем библиотеки 

import subprocess
import getpass
import sympy
import warnings

# Тело Функции 

def _main():

    """
    Эта функция выполняет скрипт.
    :return: None.
    """

    # Что хотим передать

    """
    * Показывается для образовательных целей, но данная часть
    кода не должна включаться в реальную программу; сообщение
    лучше самостоятельно вписывать
    в текстовый документ, чтобы его не было видно в консоли программы
    """

    with open("plain.txt", "w") as file:
        file.write(input("Текст сообщения, которое хотим передать:"))
    with open("plain.txt", "r") as file:
        print("Файл до шифрования: ", file.read())
        
    # Читаем ключевую фразу

    # Отключение предупреждений GetPassWarning
    
    warnings.filterwarnings("ignore", category=UserWarning, module='getpass')

    passphrase = getpass.getpass("Введите защиту:")
    password = sympy.factorint(int(passphrase))
    passlist = []
    for p in password:
        passlist.append(p)
    passphrase2 = int(input("Повторите защиту:"))
    if passphrase2 in passlist:
        passphrase2 = passphrase
    else:
        print("Ошибка!")
    if passphrase != passphrase2:
        raise ValueError("Идентификация не прошла!")

    # Выполнение шифрования
    
    print("Обработка…")

    args = [
        "gpg",
        "--batch",
        "--passphrase-fd", "0",
        "--output", "encrypted.gpg",
        "--symmetric",
        "--yes",
        "--cipher-algo", "AES256",
        "plain.txt",
    ]

    result = subprocess.run(
        args, input=passphrase.encode(),
        capture_output=True)

    if result.returncode != 0:
        raise ValueError(result.stderr)

    # Что получили

    """
    * Показывается для образовательных целей,
    но данная часть кода не должна включаться в реальную
    программу; сообщение лучше самостоятельно
    прочитать в текстовом документе, чтобы его не было видно в консоли    
    программы
    """

    with open("encrypted.gpg", "r") as file:
        print("Файл после шифрования: ", file.read())

    # Выполнение расшифровки
    
    print("Обработка...")

    args = [
        "gpg",
        "--decrypt",
        "--batch",
        "--passphrase-fd", "0",
        "--output", "decrypted.txt",
        "--yes",
        "--cipher-algo", "AES256",
        "encrypted.gpg",
    ]

    result = subprocess.run(
        args, input=passphrase.encode(),
        capture_output=True)

    if result.returncode != 0:
        raise ValueError(result.stderr)

    # Выводим результат
    
    print("Операция прошла успешно!")
    read = open("decrypted.txt", "r")
    print("Передан файл с информацией после расшифровки: ", read.read())
    read.close()

# Этот блок вызывает основную функцию

if __name__ == "__main__":
    _main()
